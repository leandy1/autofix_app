rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // El claim `dev` solo debe asignarse desde un entorno confiable usando
    // Firebase Admin SDK. Nunca se concede desde el cliente Flutter.
    function isDev() {
      return signedIn() && (
        request.auth.token.dev == true
        || (request.auth.token.email is string
          && request.auth.token.email.trim().lower()
              == 'sandyortizz32@gmail.com'
          && request.auth.token.email_verified == true)
      );
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function adminOfWorkshop(tallerId) {
      return signedIn()
        && tallerId is string
        && exists(adminPath())
        && get(adminPath()).data.tallerId == tallerId
        && get(adminPath()).data.eliminado != true;
    }

    function canAdminAccessCita(data) {
      return data.keys().hasAny(['taller_id'])
        && data.taller_id is string
        && adminOfWorkshop(data.taller_id);
    }

    function clientUidOwnsCita(data) {
      return signedIn()
        && data.keys().hasAny(['ownerUid'])
        && data.ownerUid == request.auth.uid;
    }

    function ownsCita(data) {
      return signedIn() && (
        clientUidOwnsCita(data)
        || (request.auth.token.email is string
          && data.keys().hasAny(['correo_cliente'])
          && data.correo_cliente is string
          && data.correo_cliente.trim().lower()
              == request.auth.token.email.trim().lower())
      );
    }

    function ownsVehiculo(data) {
      return signedIn() && (
        (data.keys().hasAny(['ownerUid'])
          && data.ownerUid == request.auth.uid)
        || (request.auth.token.email is string
          && data.keys().hasAny(['correo_cliente'])
          && data.correo_cliente is string
          && data.correo_cliente.trim().lower()
              == request.auth.token.email.trim().lower())
      );
    }

    function vehiculoValido(data, documentoId) {
      return data.keys().hasAll([
          'id',
          'cliente_id',
          'correo_cliente',
          'marca',
          'modelo',
          'anio',
          'placa',
          'activo',
          'creado_en',
          'actualizado_en',
          'eliminado_en',
          'sync_status'
        ])
        && data.keys().hasOnly([
          'id',
          'cliente_id',
          'correo_cliente',
          'ownerUid',
          'marca',
          'modelo',
          'anio',
          'placa',
          'activo',
          'creado_en',
          'actualizado_en',
          'eliminado_en',
          'sync_status'
        ])
        && data.id == documentoId
        && data.cliente_id is string
        && data.correo_cliente is string
        && data.correo_cliente.size() > 0
        && data.marca is string
        && data.modelo is string
        && data.anio is int
        && data.placa is string
        && data.activo is bool
        && data.creado_en is string
        && data.actualizado_en is string
        && data.sync_status == 'synced'
        && (data.eliminado_en == null || data.eliminado_en is string)
        && (!data.keys().hasAny(['ownerUid']) || data.ownerUid is string);
    }

    function puedeCrearVehiculo(data, documentoId) {
      return vehiculoValido(data, documentoId)
        && ownsVehiculo(data)
        && data.correo_cliente.trim().lower()
            == request.auth.token.email.trim().lower()
        && (!data.keys().hasAny(['ownerUid'])
          || data.ownerUid == request.auth.uid);
    }

    function devRestauraVehiculo(oldData, newData) {
      return isDev()
        && oldData.eliminado_en != null
        && newData.eliminado_en == null
        && newData.diff(oldData).affectedKeys().hasOnly([
          'eliminado_en', 'activo', 'actualizado_en', 'sync_status'
        ]);
    }

    function preservesTaller(oldData, newData) {
      return (oldData.keys().hasAny(['taller_id'])
          && newData.keys().hasAny(['taller_id'])
          && oldData.taller_id == newData.taller_id)
        || (!oldData.keys().hasAny(['taller_id'])
          && (!newData.keys().hasAny(['taller_id'])
            || newData.taller_id == null));
    }

    function devRestauraCita(oldData, newData) {
      return isDev()
        && oldData.eliminado_en != null
        && newData.eliminado_en == null
        && newData.diff(oldData).affectedKeys().hasOnly([
          'eliminado_en', 'eliminado_por', 'restaurado_en',
          'actualizado_en', 'sync_status'
        ]);
    }

    function clientCanCreateCita(data) {
      // Se acepta UID o correo autenticado. Si ownerUid está presente, se
      // impide que el cliente lo asigne a una tercera cuenta.
      return ownsCita(data)
        && (!data.keys().hasAny(['ownerUid'])
          || data.ownerUid == request.auth.uid);
    }

    function validCita(data) {
      return data.cliente is string
        && data.telefono is string
        && data.correo_cliente is string
        && data.vehiculo is string
        && data.marca is string
        && data.modelo is string
        && data.anio is int
        && data.placa is string
        && data.servicios is string
        && data.fecha_cita is string
        && data.estado is string
        && data.codigo_visible is string
        && (!data.keys().hasAny(['taller_id'])
          || data.taller_id == null
          || data.taller_id is string);
    }

    function canAccessCita(data) {
      return canAdminAccessCita(data) || ownsCita(data);
    }

    function citaPath(citaId) {
      return /databases/$(database)/documents/citas/$(citaId);
    }

    function counterTargetsNewCitaCode(citaId) {
      return citaId is string
        && existsAfter(citaPath(citaId))
        && canAccessCita(getAfter(citaPath(citaId)).data)
        && getAfter(citaPath(citaId)).data.codigo_visible is string
        && getAfter(citaPath(citaId)).data.codigo_visible.matches('^CITA-[0-9]+$')
        && (!exists(citaPath(citaId))
          || !get(citaPath(citaId)).data.keys().hasAny(['codigo_visible'])
          || get(citaPath(citaId)).data.codigo_visible == 'PENDIENTE');
    }

    match /citas/{citaId} {
      allow get, list: if canAccessCita(resource.data) || isDev();

      allow create: if validCita(request.resource.data)
        && (canAdminAccessCita(request.resource.data)
          || clientCanCreateCita(request.resource.data));

      allow update: if validCita(request.resource.data)
        && (devRestauraCita(resource.data, request.resource.data)
          || (canAdminAccessCita(resource.data)
            && canAdminAccessCita(request.resource.data))
          || (ownsCita(resource.data)
            && ownsCita(request.resource.data)
            && ((resource.data.keys().hasAny(['ownerUid'])
                  && (request.resource.data.ownerUid == resource.data.ownerUid
                    || request.resource.data.ownerUid == request.auth.uid))
                || (!resource.data.keys().hasAny(['ownerUid'])
                  && request.resource.data.ownerUid == request.auth.uid))
            && preservesTaller(resource.data, request.resource.data)));

      // La app usa tombstones (`eliminado_en`) y no necesita borrar físicamente.
      allow delete: if false;
    }

    match /vehiculos/{vehiculoId} {
      allow get, list: if ownsVehiculo(resource.data) || isDev();

      allow create: if puedeCrearVehiculo(request.resource.data, vehiculoId);

      allow update: if vehiculoValido(request.resource.data, vehiculoId)
        && (devRestauraVehiculo(resource.data, request.resource.data)
          || (ownsVehiculo(resource.data)
            && ownsVehiculo(request.resource.data)
            && request.resource.data.cliente_id == resource.data.cliente_id
            && request.resource.data.correo_cliente == resource.data.correo_cliente
            && (!resource.data.keys().hasAny(['ownerUid'])
              || request.resource.data.ownerUid == resource.data.ownerUid)));

      // Las bajas se representan con activo=false y eliminado_en; no se permite
      // borrar físicamente el documento.
      allow delete: if false;
    }

    match /clientes/{clienteUid} {
      allow get: if signedIn() && request.auth.uid == clienteUid;
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == clienteUid
        && request.resource.data.uid == clienteUid;
      // La baja del perfil también es lógica (`eliminado: true`).
      allow delete: if false;
    }

    // El mapa y el inicio de sesión necesitan leer estos catálogos autenticados.
    // Solo el usuario con claim DEV puede cambiar talleres o cuentas de Admin.
    match /talleres/{tallerId} {
      allow get, list: if signedIn();
      allow create, update: if isDev();
      allow delete: if false;
    }

    match /admins/{adminUid} {
      allow get, list: if signedIn();
      allow create, update: if isDev();
      allow delete: if false;
    }

    function catalogoBaseValido(data, documentoId) {
      return data.keys().hasAll([
          'id',
          'taller_id',
          'nombre',
          'activo',
          'creado_en',
          'actualizado_en',
          'sync_status',
          'eliminado_en'
        ])
        && data.keys().hasOnly([
          'id',
          'taller_id',
          'nombre',
          'activo',
          'creado_en',
          'actualizado_en',
          'sync_status',
          'eliminado_en'
        ])
        && data.id == documentoId
        && data.taller_id is string
        && data.nombre is string
        && data.nombre.size() > 0
        && data.activo is bool
        && data.creado_en is string
        && data.actualizado_en is string
        && data.sync_status == 'synced'
        && (data.eliminado_en == null || data.eliminado_en is string);
    }

    function servicioValido(data, documentoId) {
      return data.keys().hasAll([
          'id',
          'taller_id',
          'nombre',
          'precio',
          'activo',
          'creado_en',
          'actualizado_en',
          'sync_status',
          'eliminado_en'
        ])
        && data.keys().hasOnly([
          'id',
          'taller_id',
          'nombre',
          'precio',
          'activo',
          'creado_en',
          'actualizado_en',
          'sync_status',
          'eliminado_en'
        ])
        && data.id == documentoId
        && data.taller_id is string
        && data.nombre is string
        && data.nombre.size() > 0
        && data.precio is int
        && data.precio >= 0
        && data.activo is bool
        && data.creado_en is string
        && data.actualizado_en is string
        && data.sync_status == 'synced'
        && (data.eliminado_en == null || data.eliminado_en is string);
    }

    function adminPuedeCrearCatalogo(data, documentoId) {
      return catalogoBaseValido(data, documentoId)
        && (adminOfWorkshop(data.taller_id) || isDev());
    }

    function adminPuedeEditarCatalogo(datosAnteriores, datosNuevos, documentoId) {
      return catalogoBaseValido(datosNuevos, documentoId)
        && datosAnteriores.taller_id == datosNuevos.taller_id
        && (adminOfWorkshop(datosAnteriores.taller_id) || isDev())
        && (adminOfWorkshop(datosNuevos.taller_id) || isDev());
    }

    function adminPuedeCrearServicio(data, documentoId) {
      return servicioValido(data, documentoId)
        && (adminOfWorkshop(data.taller_id) || isDev());
    }

    function adminPuedeEditarServicio(datosAnteriores, datosNuevos, documentoId) {
      return servicioValido(datosNuevos, documentoId)
        && datosAnteriores.taller_id == datosNuevos.taller_id
        && (adminOfWorkshop(datosAnteriores.taller_id) || isDev())
        && (adminOfWorkshop(datosNuevos.taller_id) || isDev());
    }

    // Lectura autenticada para configuración y agendamiento. La consulta del
    // cliente filtra taller_id; la app oculta tombstones en sus repositorios.
    // Toda baja se escribe como update con eliminado_en, nunca como delete.
    match /tecnicos/{catalogoId} {
      allow get, list: if signedIn();
      allow create: if adminPuedeCrearCatalogo(request.resource.data, catalogoId);
      allow update: if adminPuedeEditarCatalogo(
        resource.data,
        request.resource.data,
        catalogoId
      );
      allow delete: if false;
    }

    match /servicios/{catalogoId} {
      allow get, list: if signedIn();
      allow create: if adminPuedeCrearServicio(request.resource.data, catalogoId);
      allow update: if adminPuedeEditarServicio(
        resource.data,
        request.resource.data,
        catalogoId
      );
      allow delete: if false;
    }

    match /marcas/{catalogoId} {
      allow get, list: if signedIn();
      allow create: if adminPuedeCrearCatalogo(request.resource.data, catalogoId);
      allow update: if adminPuedeEditarCatalogo(
        resource.data,
        request.resource.data,
        catalogoId
      );
      allow delete: if false;
    }

    match /grupos_servicio/{catalogoId} {
      allow get, list: if signedIn();
      allow create: if adminPuedeCrearCatalogo(request.resource.data, catalogoId);
      allow update: if adminPuedeEditarCatalogo(
        resource.data,
        request.resource.data,
        catalogoId
      );
      allow delete: if false;
    }

    // Contador transaccional usado para asignar codigo_visible. Solo permite
    // crear su valor inicial y avanzar de uno en uno; nunca decrementar ni
    // alterar otros campos.
    match /counters/{counterId} {
      allow get: if signedIn() && counterId == 'citas';
      allow list: if false;
      allow create: if signedIn()
        && counterId == 'citas'
        && request.resource.data.keys().hasOnly(['nextNumber', 'lastCitaId'])
        && request.resource.data.nextNumber is int
        && request.resource.data.nextNumber == 2
        && counterTargetsNewCitaCode(request.resource.data.lastCitaId);
      allow update: if signedIn()
        && counterId == 'citas'
        && request.resource.data.keys().hasOnly(['nextNumber', 'lastCitaId'])
        && resource.data.nextNumber is int
        && request.resource.data.nextNumber == resource.data.nextNumber + 1
        && counterTargetsNewCitaCode(request.resource.data.lastCitaId);
      allow delete: if false;
    }

    // Los logs son append-only. Un usuario solo puede publicar logs propios;
    // la consulta de auditoría completa queda reservada al rol DEV.
    match /audit_logs/{logId} {
      allow get, list: if isDev();
      allow create: if signedIn()
        && request.resource.data.usuario_uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'id', 'usuario_uid', 'usuario_email', 'modulo', 'entidad_id',
          'accion', 'fecha_hora', 'dispositivo', 'detalles', 'sync_status'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'usuario_uid', 'usuario_email', 'modulo', 'entidad_id',
          'accion', 'fecha_hora', 'dispositivo', 'detalles', 'sync_status'
        ])
        && request.resource.data.id == logId
        && request.resource.data.accion in ['eliminacion', 'restauracion']
        && request.resource.data.sync_status == 'synced';
      // Permite únicamente reintentar una escritura idéntica tras perder la
      // respuesta de red; el contenido sigue siendo inmutable.
      allow update: if signedIn()
        && resource.data.usuario_uid == request.auth.uid
        && request.resource.data == resource.data;
      allow delete: if false;
    }

    // Todo lo que no esté definido arriba queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
